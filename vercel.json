{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": "{frontend/**,tests/**,docs/**,docker/**,database/**,*.md}"
      }
    }
  ],
  "env": {
    "USE_SQLITE": "true",
    "USE_REDIS": "false",
    "DATASETS_DIR": "/tmp/datasets",
    "REPORTS_DIR": "/tmp/reports",
    "MAST_CACHE_DIR": "/tmp/mast_cache",
    "SQLITE_URL": "sqlite+aiosqlite:////tmp/horizon.db",
    "MAX_UPLOAD_SIZE_MB": "4"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
